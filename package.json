{
  "name": "spendwiseapi",
  "version": "1.0.0",
  "description": "Smart Expense Tracker API - Nigerian bank SMS expense tracker",
  "main": "dist/server.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node --files src/server.ts\"",
    "seed:categories": "ts-node src/scripts/seedCategories.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "report:run": "ts-node src/scripts/runMonthlyReport.ts"
  },
  "keywords": [
    "expense-tracker",
    "fintech",
    "nigeria",
    "sms-parser"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/csv-stringify": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.2",
    "@types/node-cron": "^3.0.11",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
